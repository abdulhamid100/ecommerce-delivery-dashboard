    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#184f95",
  "center": "#6da7ec",
  "minimum": "#cde2fb",
  "null": "#e1e0d9",
  "textClasses": {
    "callout": {
      "fontSize": 26,
